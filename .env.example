# ---------------------------------------------------------------------------
# Hive — configurazione server
# Copia in `.env` e adatta. Il file `.env` NON va in git.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Rete -------------------------------------------------------------------
# La API+WS ascoltano qui; nginx fa da reverse proxy sulla porta 80.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Origine pubblica da cui si raggiunge l'app (usata per i link d'invito e CORS).
PUBLIC_ORIGIN=http://10.0.0.76

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://hive:hive_dev_local@127.0.0.1:5432/hive
REDIS_URL=redis://127.0.0.1:6379

# --- Sicurezza --------------------------------------------------------------
# Genera con:  openssl rand -hex 32
AUTH_SECRET=CAMBIAMI_openssl_rand_hex_32
# Chiave per cifrare i segreti per-workspace salvati su DB (AES-256-GCM).
# Genera con:  openssl rand -hex 32
SECRETS_KEY=CAMBIAMI_openssl_rand_hex_32

# --- Modelli ----------------------------------------------------------------
# Gli agenti SVILUPPATORE girano sul Claude Agent SDK (Claude Code come
# libreria) e quindi accettano solo modelli Claude. Due modi per autenticarli:
#
# 1) ABBONAMENTO (preferito con HIVE_CLAUDE_AUTH=auto).
#    Genera un token durevole con:
#        claude setup-token
#    e incollalo qui sotto. Va usato anche nei container degli agenti
#    sviluppatore, dove il file ~/.claude/.credentials.json non è raggiungibile.
CLAUDE_CODE_OAUTH_TOKEN=
#
# 2) API KEY da https://platform.claude.com — usata se il token manca.
ANTHROPIC_API_KEY=
#
# auto = abbonamento se c'è, altrimenti API key | subscription | api-key
HIVE_CLAUDE_AUTH=auto

# Chiave OpenRouter: abilita gli agenti ASSISTENTE su qualunque modello
# tool-capable (~270: Gemini, GPT, Kimi, Qwen, DeepSeek, Llama...).
# Prendila da https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modello proposto di default alla creazione di un agente.
HIVE_DEFAULT_MODEL=anthropic/claude-opus-4-8
# Ogni quante ore risincronizzare il catalogo modelli da OpenRouter.
MODEL_SYNC_INTERVAL_HOURS=12

# --- Runtime agenti ---------------------------------------------------------
# Turni di agente eseguiti in parallelo. Oltre questo limite i run si accodano.
# Su questa macchina (4 vCPU / 8GB) 3 è il valore prudente, 6 il tetto.
AGENT_MAX_CONCURRENCY=3
# Secondi di inattività dopo cui il container di un progetto viene spento.
AGENT_CONTAINER_IDLE_TTL=900
# Immagine usata per i container di isolamento degli agenti sviluppatore.
# Costruiscila (o ricostruiscila quando cambia il Dockerfile) con:
#   ./deploy/build-sandbox.sh
AGENT_DEV_IMAGE=hive/dev-sandbox:latest
# Radice sul filesystem host dove vivono i workspace dei progetti.
HIVE_WORKSPACE_ROOT=/srv/hive/workspaces
HIVE_UPLOAD_ROOT=/srv/hive/uploads
# Isolamento degli agenti SVILUPPATORE (quelli con shell e filesystem):
#   docker  = ogni turno gira in un container che monta SOLO la cartella del
#             progetto; l'agente non vede ~/.claude, il .env del server né gli
#             altri progetti. DB/Redis via socket unix (niente porte in rete).
#             È il confine forte, consigliato. Richiede Docker installato.
#   sandbox = sandbox nativo dell'SDK (bubblewrap). Più leggero ma su Ubuntu con
#             apparmor_restrict_unprivileged_userns=1 non parte, e comunque non
#             confina le letture. Solo per macchine non blindate.
#   none    = nessun isolamento, solo se ti fidi di tutto il codice eseguito.
AGENT_ISOLATION=docker
