# ---------------------------------------------------------------------------
# Hive Runner — configurazione (gira sul TUO computer)
# ---------------------------------------------------------------------------
# Con questo file avvii Hive in modalità "runner locale": gli agenti di cui
# sei proprietario e che hai impostato su esecuzione "local" girano su QUESTA
# macchina — sul tuo codice, con le tue credenziali Claude — invece che sul
# server. Il server resta il centro dati condiviso a cui ti colleghi.
#
# Copia in `deploy/runner.env` e compila. NON committare il file.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Collegamento al server Hive (il "cloud" dei dati) ----------------------
# DB e Redis del server, raggiunti via LAN/VPN. Il server deve esporli sulla
# rete (di norma sono su 127.0.0.1: vedi RUNNER.md per aprirli in sicurezza).
DATABASE_URL=postgres://hive:LA_PASSWORD@10.0.0.76:5432/hive
REDIS_URL=redis://10.0.0.76:6379
# Deve essere IDENTICA alla SECRETS_KEY del server (serve a leggere i segreti
# condivisi del progetto). Chiedila a chi amministra il server.
SECRETS_KEY=INCOLLA_LA_STESSA_DEL_SERVER

# --- Chi sei ----------------------------------------------------------------
# Il tuo user id su Hive (lo trovi nelle Impostazioni → Il tuo profilo).
HIVE_RUNNER_USER_ID=INCOLLA_IL_TUO_USER_ID
HIVE_RUNNER_NAME=Il mio Mac

# --- Dove lavorano gli agenti sviluppatore ----------------------------------
# Cartella locale in cui gli agenti "local" clonano/aprono il repo del progetto.
HIVE_WORKSPACE_ROOT=/Users/tuonome/hive-workspaces

# Nessun container sul tuo computer: qui giri in locale, nel tuo perimetro.
AGENT_ISOLATION=none

# --- Cartella di codice VIVA (il modo "SSH + Claude Code") ------------------
# Se la imposti, gli agenti sviluppatore di questo runner lavorano DIRETTAMENTE
# qui — il tuo codice già sul disco — senza clonare niente da GitHub. È così che
# replichi in chat il tuo flusso "apro Claude Code nella cartella e lavoro live".
# Lasciala vuota per usare invece il clone da GitHub (in HIVE_WORKSPACE_ROOT).
HIVE_RUNNER_WORKDIR=/percorso/al/tuo/progetto


# --- Autenticazione Claude (LOCALE, la tua) ---------------------------------
# Preferito: un token del tuo abbonamento, da `claude setup-token`.
# In alternativa lascia vuoto: userà ~/.claude/.credentials.json di questo Mac.
CLAUDE_CODE_OAUTH_TOKEN=
HIVE_CLAUDE_AUTH=auto
# Se usi modelli non-Claude via OpenRouter, la tua chiave:
OPENROUTER_API_KEY=

# Quanti turni in parallelo sul tuo computer.
AGENT_MAX_CONCURRENCY=2
